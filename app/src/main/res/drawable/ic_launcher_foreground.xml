<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer accent glow ring -->
    <path
        android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0"
        android:strokeWidth="2.5"
        android:strokeColor="#50D1E4FF"
        android:fillColor="#00000000" />
        
    <!-- Main glassmorphic circle container -->
    <path
        android:pathData="M54,54m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:color="#D0FFFFFF" android:offset="0.0"/>
                <item android:color="#1AFFFFFF" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glassmorphic border ring -->
    <path
        android:pathData="M54,54m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0"
        android:strokeWidth="1.5"
        android:strokeColor="#80FFFFFF"
        android:fillColor="#00000000" />

    <!-- Sharp, professional play triangle in the center with a bright cyan/teal gradient fill -->
    <path
        android:pathData="M44,37.5 L73,54 L44,70.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="37"
                android:endX="73"
                android:endY="71"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0"/>
                <item android:color="#D1E4FF" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
